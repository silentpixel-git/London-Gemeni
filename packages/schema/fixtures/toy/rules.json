        ],
        "asQuote": true
      }
    ]
  },
  {
    "id": "tick_housekeeper_comes_to_the_light",
    "trigger": {
      "kind": "tick"
    },
    "when": {
      "act": [
        0
      ],
      "location": [
        "study"
      ],
      "flagsAll": [
        "candle_lit"
      ]
    },
    "once": true,
    "weight": 2,
    "effects": [
      {
        "kind": "summonPerson",
        "person": "housekeeper"
      },
      {
        "kind": "playBeat",
        "beats": [
