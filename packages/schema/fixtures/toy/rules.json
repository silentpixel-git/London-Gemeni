[
  {
    "id": "greet_housekeeper",
    "trigger": {
      "kind": "proximity",
      "person": "housekeeper"
    },
    "when": {
      "act": [
        0
      ]
    },
    "once": true,
    "effects": [
      {
        "kind": "playBeat",
        "beats": [
          "The housekeeper says the master would not have wanted strangers in the house, and then that she supposes it hardly matters now."
        ]
      },
      {
        "kind": "setDisposition",
        "person": "housekeeper",
        "disposition": "neutral"
      }
    ]
  },
  {
    "id": "housekeeper_tells_key",
    "trigger": {
      "kind": "disclosed",
      "fact": "key_in_clock",
      "from": "housekeeper",
      "to": "player"
    },
    "once": true,
    "effects": [
      {
        "kind": "setFlag",
        "flag": "knows_key_location"
      }
    ]
  },
  {
    "id": "open_clock_knowing",
    "trigger": {
      "kind": "action",
      "verb": [
        "open"
      ],
      "target": [
        "hall_clock"
      ]
    },
    "when": {
      "flagsAll": [
        "knows_key_location"
      ]
    },
    "once": true,
    "effects": [
      {
        "kind": "playBeat",
        "beats": [
          "Exactly where she said it would be."
        ]
      }
    ]
  },
  {
    "id": "housekeeper_remembers_overnight",
    "trigger": {
      "kind": "flag",
      "flag": "knows_key_location"
    },
    "once": true,
    "effects": [
      {
        "kind": "grantFact",
        "person": "housekeeper",
        "fact": "master_was_afraid",
        "delayPeriods": 1
      }
    ]
  },
  {
    "id": "study_is_dark",
    "trigger": {
      "kind": "enter",
      "location": "study"
    },
    "when": {
      "flagsNone": [
        "candle_lit"
      ]
    },
    "once": false,
    "effects": [
      {
        "kind": "playBeat",
        "beats": [
          "It is too dark to make out more than shapes."
        ]
      }
    ]
  },
  {
    "id": "clock_chimes_on_leaving",
    "trigger": {
      "kind": "leave",
      "location": "hall"
    },
    "once": false,
    "effects": [
      {
        "kind": "cue",
        "sound": "clock_chime"
      }
    ]
  },
  {
    "id": "light_candle",
    "trigger": {
      "kind": "combine",
      "items": [
        "candle",
        "matches"
      ]
    },
    "when": {
      "location": [
        "study"
      ]
    },
    "once": true,
    "effects": [
      {
        "kind": "setFlag",
        "flag": "candle_lit"
      },
      {
        "kind": "revealObject",
        "object": "letter"
      },
      {
        "kind": "playBeat",
        "beats": [
          "The flame steadies, and the desk gives up a folded sheet that was lying in plain sight all along."
        ]
      }
    ]
  },
  {
    "id": "read_letter",
    "trigger": {
      "kind": "action",
      "verb": [
        "read"
      ],
      "target": [
        "letter"
      ]
    },
    "once": true,
    "effects": [
      {
        "kind": "setFlag",
        "flag": "letter_read"
      }
    ]
  },
  {
    "id": "letter_opens_the_garden",
    "trigger": {
      "kind": "flag",
      "flag": "letter_read"
    },
    "once": true,
    "effects": [
      {
        "kind": "advanceAct",
        "act": 1
      },
      {
        "kind": "setFlag",
        "flag": "garden_unlocked"
      },
      {
        "kind": "movePerson",
        "person": "housekeeper",
        "location": "garden"
      }
    ]
  },
  {
    "id": "housekeeper_takes_letter",
    "trigger": {
      "kind": "disclosed",
      "fact": "letter_confession",
      "from": "player",
      "to": "housekeeper"
    },
    "once": true,
    "effects": [
      {
        "kind": "takeItem",
        "object": "letter"
      },
      {
        "kind": "moveObject",
        "object": "letter",
        "placement": {
          "kind": "person",
          "person": "housekeeper"
        }
      },
      {
        "kind": "setDisposition",
        "person": "housekeeper",
        "disposition": "trusting"
      },
      {
        "kind": "playBeat",
        "beats": [
          "She reads it once, folds it into her sleeve, and does not give it back."
        ]
      }
    ]
  },
  {
    "id": "midnight_bells",
    "trigger": {
      "kind": "clock",
      "atMinutes": 0,
      "act": [
        0,
        1
      ]
    },
    "once": true,
    "effects": [
      {
        "kind": "playBeat",
        "beats": [
          "Midnight, from a church somewhere beyond the wall."
        ],
        "asQuote": true
      }
    ]
  },
  {
