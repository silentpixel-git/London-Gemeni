        ]
      }
    ]
  },
  {
    "id": "wind_slams_study_door",
    "trigger": {
      "kind": "tick"
    },
    "when": {
      "act": [
        1
      ]
    },
    "once": true,
    "weight": 1,
    "effects": [
      {
        "kind": "lockExit",
        "location": "hall",
        "exit": "study_door",
        "lock": {
          "kind": "key",
          "object": "brass_key"
        }
      },
      {
        "kind": "playBeat",
        "beats": [
          "Somewhere in the house a door slams, and a lock drops."
        ],
        "asQuote": true
      }
    ]
  },
  {
