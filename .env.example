# .env.example
GEMINI_API_KEY=                 # server-only; never reaches the browser bundle
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The AI seam (packages/ai). Each job picks its own provider and model.
# Providers: gemini (default when GEMINI_API_KEY is set) or recorded (QA fixtures).
AI_SELECT_PROVIDER=
AI_SELECT_MODEL=                # default gemini-2.5-flash-lite
AI_NARRATE_PROVIDER=
AI_NARRATE_MODEL=               # default gemini-2.5-flash
AI_RECORDINGS_DIR=              # for the recorded provider

# The Story a new Investigation starts on (a directory under stories/ or
# packages/schema/fixtures/). Default: stress.
VITE_DEFAULT_STORY=
