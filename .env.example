# .env.example
GEMINI_API_KEY=                 # server-only; never reaches the browser bundle
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The AI seam (packages/ai): Gemini when GEMINI_API_KEY is set, otherwise
# replies recorded in AI_RECORDINGS_DIR (QA fixtures).
AI_SELECT_MODEL=                # default gemini-2.5-flash-lite
AI_NARRATE_MODEL=               # default gemini-2.5-flash
AI_JUDGE_MODEL=                 # default gemini-2.5-flash; judges told answers only
AI_RECORDINGS_DIR=

# The Story a new Investigation starts on (a directory under stories/ or
# packages/schema/fixtures/). Default: stress.
VITE_DEFAULT_STORY=
