  {
    "id": "demonstration",
    "trigger": {
      "kind": "flag",
      "flag": "holmes_demonstrated"
    },
    "effects": [
      {
        "kind": "moveObject",
        "object": "opera_glass",
        "placement": {
          "kind": "location",
          "location": "baker_street"
        }
      },
      {
        "kind": "cue",
