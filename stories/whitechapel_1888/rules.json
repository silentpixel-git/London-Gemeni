      },
      {
        "kind": "playBeat",
        "beats": [
          "\"Both, Watson. Both, and exactly.\" Holmes sat down rather heavily in his chair. \"I begin to think I shall have to find another occupation.\" The wager was mine."
        ]
      }
    ],
    "once": true
  },
  {
    "id": "wager_lost",
    "trigger": {
      "kind": "flag",
      "flag": "verdict_given"
    },
    "when": {
